# Local development only: `cp .env.example .env`. Names and local placeholders,
# never real values. .env and .env.* are gitignored (only this file is tracked);
# production values live only in the Out Plane environment.

# Local Postgres from docker-compose (`bun run db:up`, K-02 / BE-04): trust auth
# on 127.0.0.1, so the URL carries no password. Local tools refuse any database
# that is not on localhost AND named *_dev or *_test. Locally one role does
# everything; in production this is the SELECT-only portfolio_reader (SEC-14).
PG_CONNECTION_URL=postgres://portfolio@localhost:5432/portfolio_dev

# Production-only database roles (SEC-14, scripts/sql/least-privilege.sql).
# Never set locally and never written to disk: they exist only in the Out
# Plane env and reach a one-off command through `outplane env run`.
# - Writer (portfolio_writer, posts DML): read only by the publish CLI with
#   --prod, which ignores .env files (`bun run content:publish <file> --prod`).
#   The server never reads it.
# PG_WRITE_CONNECTION_URL=
# - Migrations (the owner role, DDL; a direct session, not a pooler): used by
#   src/db/migrate.ts at deploy and by drizzle-kit, before PG_CONNECTION_URL.
#   Needed on every production start once PG_CONNECTION_URL is the reader.
# PG_MIGRATE_URL=

# DB TLS (BE-13 / SEC-22). The compose database has no TLS, so locally: disable.
# Production leaves PG_SSL_MODE unset (= verify-full, certificate + hostname
# checked); `require` is only a deliberate, temporary fallback there.
PG_SSL_MODE=disable
# Private CA for the production database, as PEM text (Out Plane env only;
# never commit a certificate or key file):
# PG_CA_CERT=

# server.ts listens on PORT (default 3000). `bun run api` sets PORT=3001 for the
# dev API itself, which binds 127.0.0.1 only; Vite proxies /api to it.
PORT=3000

# JSON log threshold (BE-08): debug | info | warn | error. /health and /ready
# requests are logged at debug.
LOG_LEVEL=info

# Security headers (SEC-04 / SEC-09). Unset locally; production changes them
# only through the Out Plane env (+ deploy):
# CSP_MODE: report-only (default) | enforce. Enforce after a week of
#   Report-Only without unexplained violations; back to report-only to undo.
# CSP_MODE=report-only
# HSTS_MAX_AGE: seconds, default 86400 (1 day). 31536000 after a quiet week;
#   0 makes browsers forget the policy (rollback). includeSubDomains, no preload.
# HSTS_MAX_AGE=86400

# /api read rate limit (SEC-10 / BE-18, T-08): requests per minute per client
# (default 60). RATE_LIMIT_DISABLED=1 switches the limiter off (emergency only).
# RL_READ_PER_MIN=60
# RATE_LIMIT_DISABLED=1

# Analytics (ANL-01, T-13): baked into the client at build time. Keep the
# website id empty locally: tracking runs only in production on www.
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://stats.cengizhankose.com/script.js

# Deliberately not set here. Only inside `outplane env run ...` for a one-off
# production task (`--prod` for scripts, ALLOW_REMOTE_DB=1 for drizzle-kit;
# the publish CLI accepts only --prod):
# ALLOW_REMOTE_DB=1
